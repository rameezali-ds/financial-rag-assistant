# Copy this file to .env and fill in your values
# cp .env.example .env

# Required: Groq API key (free at console.groq.com)
GROQ_API_KEY=gsk_...

# Data directories
CHROMA_PERSIST_DIR=./data/chroma
RAW_DATA_DIR=./data/raw

# SEC EDGAR — use your real email per EDGAR Terms of Service
SEC_EDGAR_EMAIL=your.email@example.com
