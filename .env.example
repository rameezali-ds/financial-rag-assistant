# Copy this file to .env and fill in your values
# cp .env.example .env

# Required: Groq API key (free at console.groq.com)
GROQ_API_KEY=gsk_...

# Optional: OpenAI as alternative LLM (paid, ~$0.01/query)
# To switch back to OpenAI, update the import in src/agents/nodes.py
# OPENAI_API_KEY=sk-...

# Optional: Anthropic Claude as alternative LLM
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Tavily for web search fallback (free tier available)
# TAVILY_API_KEY=tvly-...

# Optional: LangSmith tracing (free, highly recommended — shows the agent graph live)
# Sign up at smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=finsight-rag

# Data directories (defaults work fine, no need to change)
CHROMA_PERSIST_DIR=./data/chroma
RAW_DATA_DIR=./data/raw

# SEC EDGAR — use your real email per EDGAR Terms of Service
SEC_EDGAR_EMAIL=your.email@example.com
